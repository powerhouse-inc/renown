NEXT_PUBLIC_CONNECT_URL=""
NEXT_PUBLIC_VITE_WALLET_CONNECT_PROJECT_ID=""
ORIGIN_URL="*"
NEXT_PUBLIC_EIP712VC_NAME="Renown"
NEXT_PUBLIC_EIP712VC_VERSION="0.1"
NEXT_PUBLIC_VERIFYING_CONTRACT=""
JWT_PRIVATE_KEY=""
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
NEXT_PUBLIC_VITE_INFURA_PROJECT_ID=""
NEXT_PUBLIC_SWITCHBOARD_ENDPOINT="https://switchboard.renown.vetra.io/graphql"
NEXT_PUBLIC_RENOWN_DRIVE_ID="renown-profiles"

# Privy embedded-wallet adapter (optional)
# Set NEXT_PUBLIC_PRIVY_APP_ID to enable social/email login through Privy.
# Without it the app keeps working with only the wagmi/RainbowKit adapter.
NEXT_PUBLIC_PRIVY_APP_ID=""
NEXT_PUBLIC_PRIVY_CLIENT_ID=""

# OpenPanel analytics (optional)
# Set NEXT_PUBLIC_OPENPANEL_CLIENT_ID to enable product analytics. Leaving it
# blank makes the integration a no-op — the SDK is never loaded.
# NEXT_PUBLIC_OPENPANEL_API_URL is optional; blank uses the OpenPanel cloud.
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=""
NEXT_PUBLIC_OPENPANEL_API_URL=""

# OIDC provider (optional)
# The issuer a deployment's /oidc/login page trusts, besides the built-in
# default (services/oidc.ts). Leave blank to only trust the default issuer.
NEXT_PUBLIC_RENOWN_OIDC_ISSUER=""
# Organisation reads from the server (optional, server-only: never NEXT_PUBLIC_)
# RENOWN_TRUSTED_READ_TOKEN: shared secret sent with server-side renown-orgs reads,
# so the switchboard rate-limits per visitor (X-Renown-Client-IP) instead of per server.
# RENOWN_TRUST_VERCEL_HEADERS: set to "1" ONLY when deployed on Vercel, where the
# platform sets x-vercel-forwarded-for. Leave unset behind our own ingress (k8s), where
# a visitor could send that header; the visitor IP then comes from x-real-ip, the last
# x-forwarded-for hop, or the socket.
RENOWN_TRUSTED_READ_TOKEN=""
RENOWN_TRUST_VERCEL_HEADERS=""
